---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { locations, getLocation } from '../../data/locations.js';

export function getStaticPaths() {
  return locations.map((l) => ({ params: { city: l.slug }, props: { loc: l } }));
}

const { loc } = Astro.props;
const site = 'https://customsuitandshirt.com';
const intro = Array.isArray(loc.intro) ? loc.intro : (loc.intro ? [loc.intro] : []);

// Breadcrumb schema — Home › Locations › City
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: `${site}/locations` },
    { '@type': 'ListItem', position: 3, name: loc.city, item: `${site}/locations/${loc.slug}` },
  ],
};

// Per-city Service schema — local signal, provided by the business, served in this city.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site}/locations/${loc.slug}#service`,
  name: `Custom Tailoring in ${loc.city}`,
  serviceType: 'Bespoke and made-to-measure tailoring',
  provider: { '@id': `${site}/#business` },
  areaServed: [
    { '@type': 'City', name: loc.city },
    ...((loc.neighbourhoods || []).map((n) => ({ '@type': 'Place', name: n }))),
  ],
  url: `${site}/locations/${loc.slug}`,
  description: loc.blurb,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Sam's Menswear — ${loc.city}`,
    itemListElement: (loc.services || []).map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s },
    })),
  },
};
---
<BaseLayout
  title={loc.metaTitle || `Custom Suits in ${loc.city} — Sam's Menswear`}
  description={loc.metaDesc || `${loc.headline} ${loc.blurb}`}
>
  <section class="page-hero">
    <div class="container">
      <div data-reveal>
        <div class="eyebrow-rule">Serving {loc.city}</div>
        <h1>{loc.h1 ? <Fragment set:html={loc.h1} /> : <>Tailoring in <em>{loc.city}.</em></>}</h1>
        <p class="lede">{loc.headline}</p>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="visit-block" data-reveal>
        <div>
          <p class="body-prose" style="font-size: 20px;">{loc.blurb}</p>
          {intro.map((p) => <p class="body-prose" style="margin-top: 18px;">{p}</p>)}

          <p class="body-prose" style="margin-top: 18px;">
            For {loc.city} clients, Sam makes
            <a href="/suits" style="color: var(--ink); border-bottom: 1px solid var(--rule);">custom suits</a>,
            <a href="/wedding" style="color: var(--ink); border-bottom: 1px solid var(--rule);">wedding suits &amp; tuxedos</a>,
            <a href="/business" style="color: var(--ink); border-bottom: 1px solid var(--rule);">business suits</a>,
            <a href="/custom" style="color: var(--ink); border-bottom: 1px solid var(--rule);">custom shirts</a> and
            <a href="/traditional" style="color: var(--ink); border-bottom: 1px solid var(--rule);">traditional menswear</a> —
            all measured personally.
          </p>

          <h2 class="h-4" style="text-transform: uppercase; margin-top: 36px; color: var(--navy);">What Sam does here</h2>
          <div class="chip-row">
            {loc.services.map((s) => <span class="chip">{s}</span>)}
          </div>

          {loc.neighbourhoods && loc.neighbourhoods.length > 0 && (
            <>
              <h2 class="h-4" style="text-transform: uppercase; margin-top: 32px; color: var(--navy);">Neighbourhoods Sam serves</h2>
              <div class="chip-row">
                {loc.neighbourhoods.map((n) => <span class="chip">{n}</span>)}
              </div>
            </>
          )}

          <h2 class="h-4" style="text-transform: uppercase; margin-top: 32px; color: var(--navy);">Also nearby</h2>
          <div class="chip-row">
            {loc.nearby.map((n) => <span class="chip">{n}</span>)}
          </div>

          <dl style="margin-top: 36px; font-family: var(--serif); font-size: 17px; line-height: 1.6;">
            <dt class="small-tag">The atelier</dt>
            <dd style="margin: 4px 0 18px; font-size: 19px; color: var(--ink);">318 Charlton Avenue · Vaughan, Ontario</dd>
            <dt class="small-tag">Telephone</dt>
            <dd style="margin: 4px 0 0; font-size: 22px; letter-spacing: 0.06em;">
              <a href="tel:+16474580711" style="color: var(--ink); border-bottom: 1px solid var(--rule);">647 · 458 · 0711</a>
            </dd>
          </dl>

          <a href="/book" class="btn is-dark" style="margin-top: 32px; color: var(--ink); border-color: var(--ink);" data-open-booking data-no-transition>Book a Fitting</a>
        </div>

        <div class="visit-map" aria-label={`Map — serving ${loc.city}`}>
          <svg viewBox="0 0 400 320" preserveAspectRatio="xMidYMid slice" style="width:100%; height:100%; display:block;">
            <defs>
              <pattern id="grid-loc" width="22" height="22" patternUnits="userSpaceOnUse">
                <path d="M22 0H0V22" fill="none" stroke="rgba(43,31,18,0.06)" stroke-width="1"/>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid-loc)"/>
            <g fill="none" stroke="rgba(43,31,18,0.34)" stroke-linecap="round" stroke-width="1.8">
              <path d="M 0 90 L 400 110"/>
              <path d="M 0 200 L 400 220"/>
              <path d="M 120 0 L 100 320"/>
              <path d="M 260 0 L 280 320"/>
              <path d="M 60 60 L 380 280" stroke-width="1.2"/>
            </g>
            <g fill="none" stroke="rgba(180,138,58,0.5)" stroke-width="3.5" stroke-linecap="round">
              <path d="M 0 250 Q 200 230 400 260"/>
            </g>
            <text x="20" y="100" fill="rgba(43,31,18,0.5)" font-family="Cormorant Garamond" font-style="italic" font-size="11" letter-spacing="2">RUTHERFORD&nbsp;RD</text>
            <text x="20" y="210" fill="rgba(43,31,18,0.5)" font-family="Cormorant Garamond" font-style="italic" font-size="11" letter-spacing="2">HWY&nbsp;7</text>
            <g transform="translate(210 160)">
              <circle r="22" fill="rgba(107,34,40,0.10)"/>
              <circle r="14" fill="rgba(107,34,40,0.18)"/>
              <circle r="6" fill="var(--oxblood)"/>
              <text x="0" y="-30" text-anchor="middle" fill="var(--ink)" font-family="Cormorant Garamond" font-style="italic" font-size="13" letter-spacing="3">{loc.city.toUpperCase()}</text>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  {loc.faqs && loc.faqs.length > 0 && (
    <section class="section tight">
      <div class="container">
        <div data-reveal style="max-width: 760px;">
          <div class="eyebrow-rule">{loc.city} — good to know</div>
          <h2 class="h-2" style="margin-bottom: 24px;">Questions from <em>{loc.city}</em> clients</h2>
          <FaqBlock items={loc.faqs} />
        </div>
      </div>
    </section>
  )}

  <section class="section flush">
    <div class="container">
      <div class="booking-block" data-reveal>
        <div>
          <div class="eyebrow-rule" style="color: var(--gold-soft); margin-bottom: 28px;">
            <span style="background: var(--navy-deep);">{loc.city} &amp; the GTA</span>
          </div>
          <h2 class="h-1">Measured <em>personally.</em></h2>
          <p class="lede" style="margin-top: 24px;">At the Vaughan atelier, or wherever a party needs to be measured together. Start with a conversation.</p>
        </div>
        <div class="actions">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Fitting</a>
          <div class="contact-tag" style="margin-top: 12px;">
            <a href="/locations" style="color: var(--gold-soft); border-bottom: 1px solid var(--gold-soft);">All locations</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</BaseLayout>
