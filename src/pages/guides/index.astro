---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('guides')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)
);
// group by pillar
const pillars = [];
for (const g of all) {
  let p = pillars.find((x) => x.name === g.data.pillar);
  if (!p) { p = { name: g.data.pillar, items: [] }; pillars.push(p); }
  p.items.push(g);
}
---
<BaseLayout
  title="Guides — Bespoke Tailoring, Explained | Sam's Menswear"
  description="Plain-spoken guides from a tailor of 30 years: what a custom suit costs, bespoke vs made-to-measure, how a suit should fit, cloth, weddings and more."
>
  <section class="page-hero">
    <div class="container">
      <div data-reveal>
        <div class="eyebrow-rule">The Atelier · Guides</div>
        <h1>Tailoring, <em>explained.</em></h1>
        <p class="lede">Thirty years of answers, written down. What things cost, how long they take, how a suit should actually fit, and how to choose the cloth — the conversations I have at the bench, minus the sales gloss.</p>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      {pillars.map((p) => (
        <div class="guide-pillar" data-reveal>
          <h2 class="faq-cat__h">{p.name}</h2>
          <div class="journal-list">
            {p.items.map((g) => (
              <a class="journal-card" href={`/guides/${g.id}`}>
                <div class="journal-card__eyebrow">{g.data.eyebrow}</div>
                <div class="journal-card__title">{g.data.title}</div>
                <p class="journal-card__excerpt">{g.data.description}</p>
                <div class="journal-card__more">Read the guide</div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section flush">
    <div class="container">
      <div class="booking-block" data-reveal>
        <div>
          <div class="eyebrow-rule" style="color: var(--gold-soft); margin-bottom: 28px;">
            <span style="background: var(--navy-deep);">Enough reading</span>
          </div>
          <h2 class="h-1">Bring the questions <em>to the bench.</em></h2>
          <p class="lede" style="margin-top: 24px;">The first fitting is free and unhurried. Or design your suit first and we'll start from your drawing.</p>
        </div>
        <div class="actions">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Fitting</a>
          <div class="contact-tag" style="margin-top: 12px;">
            Or <a href="/design" style="color: var(--gold-soft); border-bottom: 1px solid var(--gold-soft);">design your suit</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
