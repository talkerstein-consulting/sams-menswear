---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/Testimonials.astro';
import { reviews } from '../data/reviews.js';

const site = 'https://customsuitandshirt.com';
const gta = ['Vaughan', 'Thornhill', 'Toronto', 'North York', 'Richmond Hill', 'Markham', 'Woodbridge'];
// Service node — provided by the #business, served across the GTA.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site}/traditional#service`,
  name: 'Traditional & Jewish Menswear',
  serviceType: 'Traditional Jewish menswear tailoring',
  provider: { '@id': `${site}/#business` },
  areaServed: gta.map((c) => ({ '@type': 'City', name: c })),
  url: `${site}/traditional`,
  description: 'Traditional Jewish menswear cut by hand in Vaughan and Thornhill — bekishe, kapota, kittel, Shabbos suits and chosson tailoring, handled with discretion and never on Shabbos.',
};
---
<BaseLayout
  nav="traditional"
  title="Traditional Jewish Menswear — Vaughan & Thornhill | Sam's"
  description="Traditional Jewish menswear in Vaughan & Thornhill — Shabbos suits, kapota, bekishe, kittel and chosson tailoring, handled with discretion and respect by Sam."
>

  <section class="page-hero">
    <div class="container">
      <div data-reveal>
        <div class="eyebrow-rule">House № 04 &middot; Traditional</div>
        <h1>For <em>Shabbos, Yom Tov,</em> and every simcha in between.</h1>
        <p class="lede">Traditional menswear cut with the discretion and craft a community expects. Bekishe, kapota, kittel, Shabbos suits, bar mitzvah and chosson tailoring &mdash; drawn personally, finished by hand.</p>
        <div class="hero-cta-row">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Fitting</a>
          <a href="tel:+16474580711" class="hero-cta-call" data-no-transition>or call 647 · 458 · 0711</a>
        </div>
        <p class="cta-trust">★ 4.7 · 150+ Google reviews · Discreet, one-on-one, never on Shabbos</p>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="split wide-right" data-reveal>
        <div>
          <h2 class="h-2" style="text-transform: uppercase;">A garment that <em style="font-style: italic; font-weight: 400; text-transform: none; color: var(--oxblood);">welcomes Shabbos.</em></h2>
        </div>
        <div>
          <p class="lede" style="margin-bottom: 24px;">A bekishe is not a costume. A kapota is not a uniform. They are the cloth of a community's most personal moments — and they deserve the same patience as a wedding suit.</p>
          <p class="body-prose">
            Sam has been tailoring traditional Jewish menswear in Vaughan and Thornhill for over twenty years, for families in every minyan from Bathurst to Rutherford. Father to son, generation to generation, with a long memory for the family's pattern book.
          </p>
          <p class="body-prose" style="margin-top: 18px;">
            Every garment is fitted in the atelier, in a quiet room, on the customer's own schedule &mdash; without rush, without distraction, and never on Shabbos or Yom Tov.
          </p>
          <p style="margin-top: 28px;">
            <a href="/guides/the-traditional-jewish-wardrobe" style="font-family: var(--serif); font-style: italic; letter-spacing: 0.18em; text-transform: uppercase; font-size: 14px; color: var(--ink); border-bottom: 1px solid var(--rule-strong); padding-bottom: 2px;">Read the guide to the traditional Jewish wardrobe&nbsp;&nbsp;&rarr;</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- The garments grid -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 02</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">The <em>garments.</em></h2>
        <div class="right">Tailored personally · Hand-finished</div>
      </div>

      <div data-reveal-stagger class="rgrid rgrid-3" style="margin-top: clamp(40px, 5vw, 72px);">

        <!-- Bekishe -->
        <article style="background: var(--paper-cream); border: 1px solid var(--rule); padding: 32px; display: flex; flex-direction: column;">
          <div style="aspect-ratio: 3 / 4; background: var(--paper); border: 1px solid var(--rule); margin: -20px -20px 24px; padding: 20px; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 140 200" fill="none" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" style="width: 70%; height: 100%;">
              <path d="M48 32 C 50 24, 58 20, 70 20 C 82 20, 90 24, 92 32"/>
              <path d="M48 32 L 34 188"/>
              <path d="M92 32 L 106 188"/>
              <path d="M34 188 L 106 188"/>
              <path d="M70 32 L 70 188"/>
              <path d="M58 32 L 70 38 L 82 32"/>
              <circle cx="70" cy="50" r="1.6" fill="var(--ink)"/>
              <circle cx="70" cy="68" r="1.6" fill="var(--ink)"/>
              <circle cx="70" cy="86" r="1.6" fill="var(--ink)"/>
              <circle cx="70" cy="104" r="1.6" fill="var(--ink)"/>
              <circle cx="70" cy="122" r="1.6" fill="var(--ink)"/>
              <circle cx="70" cy="140" r="1.6" fill="var(--ink)"/>
              <circle cx="70" cy="158" r="1.6" fill="var(--ink)"/>
              <circle cx="70" cy="176" r="1.6" fill="var(--ink)"/>
              <path d="M40 88 L 100 88 L 100 96 L 40 96 Z" fill="var(--ink)" opacity="0.85"/>
              <g fill="rgba(43, 31, 18, 0.18)">
                <path d="M48 32 L 70 32 L 70 188 L 34 188 L 48 32"/>
                <path d="M70 32 L 92 32 L 106 188 L 70 188 L 70 32"/>
              </g>
              <ellipse cx="70" cy="14" rx="22" ry="6" fill="var(--ink)" opacity="0.85"/>
            </svg>
          </div>
          <div class="chapter-no heb-num" style="color: var(--gold);">א</div>
          <h3 class="h-3" style="margin-top: 6px; text-transform: uppercase; color: var(--navy);">Bekishe</h3>
          <p class="body-prose" style="margin-top: 12px; font-size: 16px;">
            Satin or fine wool, full-length, single-breasted closure with double-row stitching. Cut to drape from the shoulders without strain, with allowance for the gartel and tzitzis.
          </p>
          <div class="small-tag" style="margin-top: 18px; color: var(--ink-mute);">Shabbos · Yom Tov · Simcha</div>
        </article>

        <!-- Kapota -->
        <article style="background: var(--paper-cream); border: 1px solid var(--rule); padding: 32px; display: flex; flex-direction: column;">
          <div style="aspect-ratio: 3 / 4; background: var(--paper); border: 1px solid var(--rule); margin: -20px -20px 24px; padding: 20px; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 140 200" fill="none" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" style="width: 70%; height: 100%;">
              <path d="M48 32 C 50 24, 58 20, 70 20 C 82 20, 90 24, 92 32"/>
              <path d="M48 32 L 34 188"/>
              <path d="M92 32 L 106 188"/>
              <path d="M34 188 L 106 188"/>
              <path d="M62 32 L 62 188"/>
              <path d="M78 32 L 78 188"/>
              <path d="M62 32 L 50 70 L 62 86"/>
              <path d="M78 32 L 90 70 L 78 86"/>
              <circle cx="62" cy="60" r="1.6" fill="var(--ink)"/>
              <circle cx="62" cy="100" r="1.6" fill="var(--ink)"/>
              <circle cx="62" cy="130" r="1.6" fill="var(--ink)"/>
              <circle cx="62" cy="160" r="1.6" fill="var(--ink)"/>
              <g fill="rgba(28, 37, 64, 0.20)">
                <path d="M48 32 L 62 32 L 62 188 L 34 188 L 48 32"/>
                <path d="M78 32 L 92 32 L 106 188 L 78 188 L 78 32"/>
              </g>
            </svg>
          </div>
          <div class="chapter-no heb-num" style="color: var(--gold);">ב</div>
          <h3 class="h-3" style="margin-top: 6px; text-transform: uppercase; color: var(--navy);">Kapota / Rekel</h3>
          <p class="body-prose" style="margin-top: 12px; font-size: 16px;">
            Wool worsted, lapel cut, hand-finished buttonholes. Worn daily by some, kept for Shabbos by others. Cut roomy in the chest and shoulders, narrow at the cuff.
          </p>
          <div class="small-tag" style="margin-top: 18px; color: var(--ink-mute);">Daily &amp; Shabbos wear</div>
        </article>

        <!-- Shabbos Suit -->
        <article style="background: var(--paper-cream); border: 1px solid var(--rule); padding: 32px; display: flex; flex-direction: column;">
          <div style="aspect-ratio: 3 / 4; background: var(--paper); border: 1px solid var(--rule); margin: -20px -20px 24px; padding: 20px; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 140 200" fill="none" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" style="width: 70%; height: 100%;">
              <path d="M44 38 C 46 30, 54 26, 70 26 C 86 26, 94 30, 96 38"/>
              <path d="M44 38 L 30 160"/>
              <path d="M96 38 L 110 160"/>
              <path d="M30 160 L 110 160"/>
              <path d="M58 38 C 52 60, 50 90, 62 120"/>
              <path d="M82 38 C 88 60, 90 90, 78 120"/>
              <path d="M58 38 L 70 44 L 82 38"/>
              <path d="M52 60 L 50 140 L 90 140 L 88 60 L 70 70 Z" fill="rgba(28, 37, 64, 0.30)"/>
              <circle cx="70" cy="80" r="1.4" fill="var(--ink)"/>
              <circle cx="70" cy="98" r="1.4" fill="var(--ink)"/>
              <circle cx="70" cy="116" r="1.4" fill="var(--ink)"/>
              <path d="M70 120 L 70 160"/>
              <circle cx="70" cy="128" r="2" fill="var(--ink)"/>
              <circle cx="70" cy="144" r="2" fill="var(--ink)"/>
              <g fill="rgba(28, 37, 64, 0.20)">
                <path d="M44 38 L 58 38 L 62 120 L 70 160 L 30 160 L 44 38"/>
                <path d="M82 38 L 96 38 L 110 160 L 70 160 L 78 120 L 82 38"/>
              </g>
            </svg>
          </div>
          <div class="chapter-no heb-num" style="color: var(--gold);">ג</div>
          <h3 class="h-3" style="margin-top: 6px; text-transform: uppercase; color: var(--navy);">Shabbos Suit</h3>
          <p class="body-prose" style="margin-top: 12px; font-size: 16px;">
            The classic three-piece in black or midnight navy, single-breasted, peak or notch lapel. Cut with the room to bend, to stand, and to sit through a long davening.
          </p>
          <div class="small-tag" style="margin-top: 18px; color: var(--ink-mute);">Shabbos · Wedding · Bar Mitzvah</div>
        </article>

        <!-- Kittel -->
        <article style="background: var(--paper-cream); border: 1px solid var(--rule); padding: 32px; display: flex; flex-direction: column;">
          <div style="aspect-ratio: 3 / 4; background: var(--paper); border: 1px solid var(--rule); margin: -20px -20px 24px; padding: 20px; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 140 200" fill="none" stroke="var(--ink-mute)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" style="width: 70%; height: 100%;">
              <rect x="34" y="20" width="72" height="170" fill="#fdf8e8" stroke="var(--ink-mute)"/>
              <path d="M48 26 C 50 22, 58 20, 70 20 C 82 20, 90 22, 92 26" stroke="var(--ink)" fill="none"/>
              <path d="M48 26 L 34 190"/>
              <path d="M92 26 L 106 190"/>
              <path d="M70 26 L 70 190"/>
              <path d="M58 26 L 70 32 L 82 26"/>
              <circle cx="70" cy="46" r="1.4" fill="var(--ink)"/>
              <circle cx="70" cy="64" r="1.4" fill="var(--ink)"/>
              <circle cx="70" cy="82" r="1.4" fill="var(--ink)"/>
              <circle cx="70" cy="100" r="1.4" fill="var(--ink)"/>
              <path d="M34 110 L 106 110 L 106 116 L 34 116 Z" fill="#fdf8e8" stroke="var(--ink-mute)"/>
            </svg>
          </div>
          <div class="chapter-no heb-num" style="color: var(--gold);">ד</div>
          <h3 class="h-3" style="margin-top: 6px; text-transform: uppercase; color: var(--navy);">Kittel</h3>
          <p class="body-prose" style="margin-top: 12px; font-size: 16px;">
            White linen or cotton, simple closure ties, modest belt. Cut to last decades — for the Yamim Noraim, the Seder table, and the chuppah.
          </p>
          <div class="small-tag" style="margin-top: 18px; color: var(--ink-mute);">Yom Kippur · Pesach · Chuppah</div>
        </article>

        <!-- Bar Mitzvah Suit -->
        <article style="background: var(--paper-cream); border: 1px solid var(--rule); padding: 32px; display: flex; flex-direction: column;">
          <div style="aspect-ratio: 3 / 4; background: var(--paper); border: 1px solid var(--rule); margin: -20px -20px 24px; padding: 20px; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 140 200" fill="none" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" style="width: 65%; height: 95%;">
              <path d="M46 50 C 48 42, 56 38, 70 38 C 84 38, 92 42, 94 50"/>
              <path d="M46 50 L 36 160"/>
              <path d="M94 50 L 104 160"/>
              <path d="M36 160 L 104 160"/>
              <path d="M58 50 C 54 70, 54 90, 64 110"/>
              <path d="M82 50 C 86 70, 86 90, 76 110"/>
              <path d="M58 50 L 70 56 L 82 50"/>
              <path d="M70 110 L 70 160"/>
              <circle cx="70" cy="118" r="1.6" fill="var(--ink)"/>
              <circle cx="70" cy="138" r="1.6" fill="var(--ink)"/>
              <g fill="rgba(28, 37, 64, 0.22)">
                <path d="M46 50 L 58 50 L 64 110 L 70 160 L 36 160 L 46 50"/>
                <path d="M82 50 L 94 50 L 104 160 L 70 160 L 76 110 L 82 50"/>
              </g>
            </svg>
          </div>
          <div class="chapter-no heb-num" style="color: var(--gold);">ה</div>
          <h3 class="h-3" style="margin-top: 6px; text-transform: uppercase; color: var(--navy);">Bar Mitzvah Suit</h3>
          <p class="body-prose" style="margin-top: 12px; font-size: 16px;">
            The first suit of a boy's life. Cut with growing room in the trouser and sleeve, ready to be let out for the next two years. A small ceremony of its own.
          </p>
          <div class="small-tag" style="margin-top: 18px; color: var(--ink-mute);">Coming of age &middot; Father &amp; son</div>
        </article>

        <!-- Chosson -->
        <article style="background: var(--paper-cream); border: 1px solid var(--rule); padding: 32px; display: flex; flex-direction: column;">
          <div style="aspect-ratio: 3 / 4; background: var(--paper); border: 1px solid var(--rule); margin: -20px -20px 24px; padding: 20px; display: flex; align-items: center; justify-content: center;">
            <svg viewBox="0 0 140 200" fill="none" stroke="var(--ink)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" style="width: 70%; height: 100%;">
              <path d="M44 38 C 46 30, 54 26, 70 26 C 86 26, 94 30, 96 38"/>
              <path d="M44 38 L 30 180"/>
              <path d="M96 38 L 110 180"/>
              <path d="M30 180 L 110 180"/>
              <path d="M70 38 L 70 180"/>
              <path d="M58 38 L 70 44 L 82 38"/>
              <path d="M36 50 L 36 180 L 104 180 L 104 50 L 90 60 L 70 56 L 50 60 Z" fill="#fdf8e8" opacity="0.85"/>
              <path d="M70 56 L 70 180" stroke="var(--ink-mute)"/>
              <path d="M36 110 L 104 110 L 104 116 L 36 116 Z" fill="#fdf8e8" stroke="var(--ink-mute)"/>
              <circle cx="70" cy="74" r="1.4" fill="var(--ink-mute)"/>
              <circle cx="70" cy="90" r="1.4" fill="var(--ink-mute)"/>
              <circle cx="58" cy="56" r="2" fill="var(--gold)"/>
            </svg>
          </div>
          <div class="chapter-no heb-num" style="color: var(--gold);">ו</div>
          <h3 class="h-3" style="margin-top: 6px; text-transform: uppercase; color: var(--navy);">Chosson Tailoring</h3>
          <p class="body-prose" style="margin-top: 12px; font-size: 16px;">
            A chosson's wedding wardrobe: the Shabbos kallah suit, the chuppah kittel, the bekishe for sheva brachos. Drawn together, finished in time, fitted in the days before the wedding.
          </p>
          <div class="small-tag" style="margin-top: 18px; color: var(--ink-mute);">Chuppah · Sheva Brachos</div>
        </article>

      </div>
    </div>
  </section>

  <!-- The Calendar / Yom Tov readiness -->
  <section class="section"
           style="background: linear-gradient(180deg, transparent 0%, var(--paper-cream) 50%, transparent 100%);">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 03</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">A <em>tailor's calendar.</em></h2>
        <div class="right">Order before the season</div>
      </div>

      <div data-reveal-stagger class="rgrid rgrid-4" style="margin-top: clamp(40px, 5vw, 72px);">
        <div style="padding: 24px; background: var(--paper-cream); border: 1px solid var(--rule);">
          <div class="chapter-no" style="color: var(--gold);">Tishrei</div>
          <h3 class="h-4" style="margin-top: 6px; text-transform: uppercase;">Yamim Noraim</h3>
          <p class="body-prose" style="margin-top: 10px; font-size: 14px; line-height: 1.5;">Kittel orders close end of Elul. A second fitting is held the week before Rosh Hashanah.</p>
        </div>
        <div style="padding: 24px; background: var(--paper-cream); border: 1px solid var(--rule);">
          <div class="chapter-no" style="color: var(--gold);">Nisan</div>
          <h3 class="h-4" style="margin-top: 6px; text-transform: uppercase;">Pesach</h3>
          <p class="body-prose" style="margin-top: 10px; font-size: 14px; line-height: 1.5;">Spring suits and seder-night kittels are cut from mid-Shevat. Last orders Purim morning.</p>
        </div>
        <div style="padding: 24px; background: var(--paper-cream); border: 1px solid var(--rule);">
          <div class="chapter-no" style="color: var(--gold);">All year</div>
          <h3 class="h-4" style="margin-top: 6px; text-transform: uppercase;">Bar Mitzvah</h3>
          <p class="body-prose" style="margin-top: 10px; font-size: 14px; line-height: 1.5;">Begin six months before. Two fittings, growing-room sleeve, a small notebook entry for the next suit in two years.</p>
        </div>
        <div style="padding: 24px; background: var(--paper-cream); border: 1px solid var(--rule);">
          <div class="chapter-no" style="color: var(--gold);">By date</div>
          <h3 class="h-4" style="margin-top: 6px; text-transform: uppercase;">Chosson</h3>
          <p class="body-prose" style="margin-top: 10px; font-size: 14px; line-height: 1.5;">Begin 9–12 months from the wedding. We coordinate with the kallah's gown, the kallah's father, and the mechutanim.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 04</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">From the <em>community.</em></h2>
        <div class="right">Letters &amp; reference</div>
      </div>
      <Testimonials items={[reviews[4], reviews[10], reviews[7]]} />
    </div>
  </section>

  <!-- CTA -->
  <section class="section flush">
    <div class="container">
      <div class="booking-block" data-reveal>
        <div>
          <div class="eyebrow-rule" style="color: var(--gold-soft); margin-bottom: 28px;">
            <span style="background: var(--navy-deep);">Closed Shabbos &amp; Yom Tov &middot; By appointment</span>
          </div>
          <h2 class="h-1">Begin a <em>traditional fitting.</em></h2>
          <p class="lede" style="margin-top: 24px;">Consultations are held in a private room, on your own schedule, and never on Shabbos or Yom Tov. Sam &mdash; or a member of the family &mdash; will sit with you for the conversation.</p>
        </div>
        <div class="actions">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Private Fitting</a>
          <div class="contact-tag" style="margin-top: 12px;">
            Or call discreetly
            <div class="num">647 · 458 · 0711</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

</BaseLayout>
