---
import BaseLayout from '../layouts/BaseLayout.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { reviews } from '../data/reviews.js';
import { faqs } from '../data/faqs.js';

const weddingFaqs = faqs.filter((f) => f.cat === 'Weddings');

const site = 'https://customsuitandshirt.com';
const gta = ['Vaughan', 'Thornhill', 'Toronto', 'North York', 'Richmond Hill', 'Markham', 'Woodbridge'];
// Service node — provided by the #business, served across the GTA.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site}/wedding#service`,
  name: 'Custom Wedding Suits & Tuxedos',
  serviceType: 'Custom wedding suit and tuxedo tailoring',
  provider: { '@id': `${site}/#business` },
  areaServed: gta.map((c) => ({ '@type': 'City', name: c })),
  url: `${site}/wedding`,
  description: 'Bespoke wedding suits and tuxedos for the groom, groomsmen and both fathers — measured personally by Sam and coordinated as one tailored party. Made to fit, never rented.',
};
---
<BaseLayout
  nav="wedding"
  title="Wedding Suits & Tuxedos — Vaughan, Thornhill & the GTA"
  description="Custom wedding suits and tuxedos for the groom, groomsmen and fathers — measured personally by Sam in Vaughan, Thornhill and across the GTA. Made to fit, never rented."
>

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="container">
      <div data-reveal>
        <div class="eyebrow-rule">House № 01 &middot; Wedding</div>
        <h1>The suit he <em>will be remembered in.</em></h1>
        <p class="lede">A wedding suit is the single most photographed garment of a man's life. Sam draws each one personally — lapel, cuff, button-stance and lining — from the groom's first measure to the groomsmen's last fitting.</p>
        <div class="hero-cta-row">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Fitting</a>
          <a href="tel:+16474580711" class="hero-cta-call" data-no-transition>or call 647 · 458 · 0711</a>
        </div>
        <p class="cta-trust">★ 4.7 · 150+ Google reviews · First fitting free &amp; no-obligation</p>
      </div>
    </div>
  </section>

  <!-- STORY + SKETCH SPLIT -->
  <section class="section tight">
    <div class="container">
      <div class="split wide-left" data-reveal>
        <div>
          <h2 class="h-2" style="text-transform: uppercase;">A wedding party, <em style="font-style: italic; font-weight: 400; text-transform: none; color: var(--oxblood);">cut from one&nbsp;hand.</em></h2>
          <p class="body-prose" style="margin-top: 24px;">
            The groom is the lead, but never the only one drawn. Sam fits the father of the groom, the father of the bride, the brothers, the best man, and the ring-bearer — measuring all of them against the same notebook, so the wedding photographs read as one tailored line.
          </p>
          <p class="body-prose" style="margin-top: 18px;">
            Tuxedos in midnight wool with satin peak lapels. Three-piece suits in deep navy, charcoal, oxblood, or hunter green. Morning coats for the traditional. Cummerbunds, waistcoats, bow ties and braces, all from the house cloth.
          </p>
          <p style="margin-top: 32px;">
            <a href="/book" data-open-booking data-no-transition style="font-family: var(--serif); font-style: italic; letter-spacing: 0.18em; text-transform: uppercase; font-size: 14px; color: var(--ink); border-bottom: 1px solid var(--rule-strong); padding-bottom: 2px;">Begin a wedding consultation&nbsp;&nbsp;&rarr;</a>
          </p>
        </div>
        <div>
          <figure class="wed-portrait">
            <img src="/media/art/wedding-groom.webp" alt="The groom in a deep-navy three-piece wedding suit, drawn at the studio" loading="lazy"/>
            <figcaption>№ 01 · The Groom</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- FABRIC LIBRARY -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 02</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 16ch;">The wedding <em>cloth library.</em></h2>
        <div class="right">House &amp; mill cloths</div>
      </div>

      <div class="swatch-rail" data-reveal>
        <div class="swatch swatch--navy swatch--dark"><div class="swatch__meta">Worsted · 280g</div><div class="swatch__name">Midnight Navy</div></div>
        <div class="swatch swatch--charcoal swatch--dark"><div class="swatch__meta">Italian super 130s</div><div class="swatch__name">Charcoal Chalk</div></div>
        <div class="swatch swatch--oxblood swatch--dark"><div class="swatch__meta">Mohair blend</div><div class="swatch__name">Oxblood Velvet</div></div>
        <div class="swatch swatch--herringbone swatch--dark"><div class="swatch__meta">English herringbone</div><div class="swatch__name">Hunter Green</div></div>
        <div class="swatch swatch--espresso swatch--dark"><div class="swatch__meta">Worsted flannel</div><div class="swatch__name">Tobacco Brown</div></div>
        <div class="swatch swatch--cream"><div class="swatch__meta">Linen / silk</div><div class="swatch__name">Ivory Dinner</div></div>
        <div class="swatch swatch--check swatch--dark"><div class="swatch__meta">Glen check</div><div class="swatch__name">Country Estate</div></div>
      </div>
      <p class="chapter-no" style="margin-top: 24px; text-align: center;">— Scroll for more —</p>
    </div>
  </section>

  <!-- LOOKBOOK -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 03</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">From the <em>wedding folio.</em></h2>
        <div class="right">Grooms, parties &amp; black tie</div>
      </div>
      <div class="lookbook" data-reveal>
        <div class="lb-tile lb-1 has-photo"><img src="/media/art/wedding-groomsmen.webp" alt="A groom and his groomsmen in coordinated navy suits" loading="lazy"/><div class="placeholder"><div class="corner">Folio · I</div><div class="label">The wedding party</div><div class="meta">Groom &amp; groomsmen, coordinated</div></div></div>
        <div class="lb-tile lb-2 has-photo"><img src="/media/art/wedding-tuxedo.webp" alt="A black tuxedo with satin peak lapel and bow tie" loading="lazy"/><div class="placeholder"><div class="corner">Folio · II</div><div class="label">Black tie</div><div class="meta">Satin peak lapel &amp; bow</div></div></div>
        <div class="lb-tile lb-3 has-photo"><img src="/media/art/wedding-father-son.webp" alt="A groom and his father in coordinated navy suits" loading="lazy"/><div class="placeholder"><div class="corner">Folio · III</div><div class="label">Father &amp; son</div><div class="meta">The morning of</div></div></div>
        <div class="lb-tile lb-4 has-photo"><img src="/media/lookbook/dress-shirt.png" alt="A custom dress shirt" loading="lazy"/><div class="placeholder"><div class="corner">Folio · IV</div><div class="label">Custom dress shirt</div><div class="meta">Cut from your pattern</div></div></div>
        <div class="lb-tile lb-5 has-photo"><img src="/media/lookbook/trousers.jpg" alt="Pleated tailored trousers" loading="lazy"/><div class="placeholder"><div class="corner">Folio · V</div><div class="label">Pleated trousers</div><div class="meta">Cut to the shoe</div></div></div>
        <div class="lb-tile lb-6 has-photo"><img src="/media/lookbook/chesterfield.jpg" alt="A Chesterfield overcoat by Sam's Menswear" loading="lazy"/><div class="placeholder"><div class="corner">Folio · VI</div><div class="label">Chesterfield overcoat</div><div class="meta">Winter cloth</div></div></div>
        <div class="lb-tile lb-7 has-photo"><img src="/media/lookbook/alterations.jpg" alt="Final alterations in the fitting room" loading="lazy"/><div class="placeholder"><div class="corner">Folio · VII</div><div class="label">Final alterations</div><div class="meta">The fitting room</div></div></div>
        <div class="lb-tile lb-8 has-photo"><img src="/media/lookbook/topcoat.jpg" alt="A tailored topcoat" loading="lazy"/><div class="placeholder"><div class="corner">Folio · VIII</div><div class="label">The topcoat</div><div class="meta">House cloth</div></div></div>
        <div class="lb-tile lb-9 has-photo"><img src="/media/lookbook/overcoat.jpg" alt="A tailored overcoat" loading="lazy"/><div class="placeholder"><div class="corner">Folio · IX</div><div class="label">The overcoat</div><div class="meta">Outerwear</div></div></div>
      </div>
    </div>
  </section>

  <!-- THE PROMISE / DETAILS -->
  <section class="section"
           style="background: linear-gradient(180deg, transparent 0%, var(--paper-cream) 50%, transparent 100%);">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 04</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">What's <em>included.</em></h2>
        <div class="right">From measure to morning-of</div>
      </div>

      <div class="feature-grid cols-3" data-reveal-stagger>
        <div>
          <div class="feature-num">№ I</div>
          <h3 class="h-3">Personal consultation</h3>
          <p class="body-prose" style="margin-top: 12px;">A long, unhurried conversation about the wedding — the venue, the season, the colour story, the bride's gown, the photographs you want in twenty years.</p>
        </div>
        <div>
          <div class="feature-num">№ II</div>
          <h3 class="h-3">Twenty-six measurements</h3>
          <p class="body-prose" style="margin-top: 12px;">Taken in person by Sam. Re-checked at each fitting. A pattern is drafted just for you — not adjusted from a template, not graded from a size.</p>
        </div>
        <div>
          <div class="feature-num">№ III</div>
          <h3 class="h-3">Three fittings</h3>
          <p class="body-prose" style="margin-top: 12px;">Basted, intermediate, and final. The garment learns the shape of you across each one. Tiny corrections — drop of shoulder, sleeve pitch, trouser break — are made by hand.</p>
        </div>
        <div>
          <div class="feature-num">№ IV</div>
          <h3 class="h-3">Groomsmen co‑ordinated</h3>
          <p class="body-prose" style="margin-top: 12px;">Up to ten groomsmen drawn from the same fabric run, with consistent lapel, button and pocket detail so the wedding line reads as one tailored party.</p>
        </div>
        <div>
          <div class="feature-num">№ V</div>
          <h3 class="h-3">Pressed &amp; delivered</h3>
          <p class="body-prose" style="margin-top: 12px;">Pressed the morning of, boxed in tissue, hand-delivered to your hotel or home if you're in Vaughan or Thornhill. We carry a kit for last-minute thread emergencies.</p>
        </div>
        <div>
          <div class="feature-num">№ VI</div>
          <h3 class="h-3">Lifetime adjustments</h3>
          <p class="body-prose" style="margin-top: 12px;">Bodies change. So do anniversaries. Bring the suit back any time for a re-press, a small letting-out, or a quiet refresh. The pattern remains in our notebook.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY NOT RENT -->
  <section class="section"
           style="background: linear-gradient(180deg, transparent 0%, var(--paper-cream) 40%, transparent 100%);">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 05</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 20ch;">Why not just <em>rent it?</em></h2>
        <div class="right">The case against the rental</div>
      </div>

      <p class="body-prose" data-reveal style="max-width: 58ch; margin-bottom: 40px; font-size: 20px;">
        A rental feels cheaper on the day. Then the photos come back. A tuxedo or suit rental is cut for the average of every man who wore it before you — and on the most photographed day of your life, the camera sees every compromise. Here's the honest comparison.
      </p>

      <div class="feature-grid cols-2" data-reveal-stagger>
        <div style="border-top: 2px solid var(--rule-strong); padding-top: 20px;">
          <div class="feature-num" style="color: var(--ink-mute);">The rental</div>
          <h3 class="h-3" style="margin-bottom: 16px;">What you actually get</h3>
          <ul class="prose-list">
            <li>Cut for a crowd, adjusted toward you — never truly your fit.</li>
            <li>The same handful of styles half the season's weddings wear.</li>
            <li>Day-of risk: wrong size shipped, last wearer's stain, no time to fix it.</li>
            <li>A few hundred dollars for one night — and you keep nothing.</li>
            <li>No tailor of your own when something goes wrong.</li>
          </ul>
        </div>
        <div style="border-top: 2px solid var(--oxblood); padding-top: 20px;">
          <div class="feature-num" style="color: var(--oxblood);">Made by Sam</div>
          <h3 class="h-3" style="margin-bottom: 16px;">What you keep</h3>
          <ul class="prose-list">
            <li>Built to your twenty-six measurements — the shoulders are yours.</li>
            <li>Your cloth, your lapel, your details. One of one.</li>
            <li>Three fittings and a tailor on call right up to the morning of.</li>
            <li>Yours forever — worn again at every event after the wedding.</li>
            <li>Divided across those wears, it costs less than renting twice.</li>
          </ul>
        </div>
      </div>

      <p data-reveal style="margin-top: 36px;">
        <a href="/guides/custom-vs-rental-wedding-suit" style="font-family: var(--serif); font-style: italic; letter-spacing: 0.18em; text-transform: uppercase; font-size: 14px; color: var(--ink); border-bottom: 1px solid var(--rule-strong); padding-bottom: 2px;">Read the honest custom-vs-rental math&nbsp;&nbsp;&rarr;</a>
      </p>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section tight">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 06</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 18ch;">From the <em>groom's side.</em></h2>
        <div class="right">Letters, after the wedding</div>
      </div>
      <Testimonials items={[reviews[1], reviews[3], reviews[5]]} />
    </div>
  </section>

  <!-- WEDDING LIBRARY + FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="chapter-no">No. 07</div>
        <h2 class="h-1" style="text-transform: uppercase; max-width: 20ch;">The wedding <em>reading room.</em></h2>
        <div class="right">Everything a groom needs to know</div>
      </div>

      <div class="wed-guides" data-reveal-stagger>
        <a class="wed-guide" href="/guides/the-grooms-suit">
          <span class="wed-guide__k">The Groom</span>
          <span class="wed-guide__t">The groom's suit, done right</span>
          <span class="wed-guide__d">Colour, cloth, custom vs rental, and the timeline for the outfit you'll see in photos forever.</span>
        </a>
        <a class="wed-guide" href="/guides/the-custom-tuxedo">
          <span class="wed-guide__k">Tuxedos</span>
          <span class="wed-guide__t">The custom tuxedo</span>
          <span class="wed-guide__d">Why a tuxedo is the last thing you should rent — and what a made one gets you.</span>
        </a>
        <a class="wed-guide" href="/guides/coordinating-groomsmen">
          <span class="wed-guide__k">Groomsmen</span>
          <span class="wed-guide__t">Coordinating the party</span>
          <span class="wed-guide__d">Matching vs coordinating, setting the groom apart, and the out-of-town problem.</span>
        </a>
        <a class="wed-guide" href="/guides/father-of-the-bride-and-groom-suit">
          <span class="wed-guide__k">The Fathers</span>
          <span class="wed-guide__t">Father of the bride &amp; groom</span>
          <span class="wed-guide__d">How to dress the dads and fathers-in-law so the family photos read as one line.</span>
        </a>
        <a class="wed-guide" href="/guides/black-tie-wedding-attire">
          <span class="wed-guide__k">Dress Codes</span>
          <span class="wed-guide__t">Black tie, decoded</span>
          <span class="wed-guide__d">What black tie, black tie optional and formal actually mean — and how to nail each.</span>
        </a>
        <a class="wed-guide" href="/guides/wedding-suit-timeline">
          <span class="wed-guide__k">Timeline</span>
          <span class="wed-guide__t">The wedding suit timeline</span>
          <span class="wed-guide__d">When to start, fitting by fitting, so nothing is rushed near the date.</span>
        </a>
      </div>

      <div data-reveal style="max-width: 760px; margin-top: 64px;">
        <div class="eyebrow-rule">Wedding questions</div>
        <h3 class="h-2" style="margin-bottom: 24px;">Grooms, groomsmen &amp; fathers — <em>answered.</em></h3>
        <FaqBlock items={weddingFaqs} />
      </div>
    </div>
  </section>

  <!-- BOOKING CTA -->
  <section class="section flush">
    <div class="container">
      <div class="booking-block" data-reveal>
        <div>
          <div class="eyebrow-rule" style="color: var(--gold-soft); margin-bottom: 28px;">
            <span style="background: var(--navy-deep);">Wedding consultations · By appointment</span>
          </div>
          <h2 class="h-1">Begin a <em>wedding fitting.</em></h2>
          <p class="lede" style="margin-top: 24px;">
            First consultations are usually 9–12 months before the wedding. Bring a photograph of the bride's gown, the venue, and any suit you've loved — or none of those things, and we'll start from a blank page.
          </p>
        </div>
        <div class="actions">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Wedding Fitting</a>
          <div class="contact-tag" style="margin-top: 12px;">
            Or call the studio
            <div class="num">647 · 458 · 0711</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

</BaseLayout>
