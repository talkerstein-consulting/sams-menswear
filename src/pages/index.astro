  <script>
    // The Bespoke Journey — crossfade the sticky visual as each step
    // crosses the viewport centre. Opacity-only (GPU-cheap), no scroll scrubbing.
    const frames = document.querySelectorAll('.journey__frame');
    const dots = document.querySelectorAll('.journey__rail span');
    const steps = document.querySelectorAll('.journey__step');
    if (frames.length && steps.length) {
      const setActive = (i) => {
        frames.forEach((f) => f.classList.toggle('is-active', f.dataset.step === i));
        dots.forEach((d, di) => d.classList.toggle('is-active', String(di) === i));
      };
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => { if (e.isIntersecting) setActive(e.target.dataset.step); });
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );
      steps.forEach((s) => io.observe(s));
    }
  </script>

