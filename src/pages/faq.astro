---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { faqs, faqCategories, faqSchema } from '../data/faqs.js';

const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const byCat = faqCategories
  .map((c) => ({ cat: c, id: slug(c), items: faqs.filter((f) => f.cat === c) }))
  .filter((g) => g.items.length);
---
<BaseLayout
  title="Questions & Honest Answers — Sam's Menswear · Vaughan"
  description="Straight answers on cost, timelines, bespoke vs made-to-measure, fit, weddings, cloth and home visits — from a Vaughan tailor of 30 years serving the GTA."
>
  <section class="page-hero">
    <div class="container">
      <div data-reveal>
        <div class="eyebrow-rule">Before you book</div>
        <h1>Honest <em>answers.</em></h1>
        <p class="lede">Everything men actually ask me — cost, timing, whether it's worth it, fit, weddings, cloth, coming to your door. No sales gloss. If yours isn't here, call and I'll answer it straight.</p>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <nav class="faq-index" data-reveal aria-label="FAQ categories">
        {byCat.map((g) => <a href={`#${g.id}`}>{g.cat} <span>{g.items.length}</span></a>)}
      </nav>

      {byCat.map((g) => (
        <div class="faq-cat" id={g.id} data-reveal>
          <h2 class="faq-cat__h">{g.cat}</h2>
          <FaqBlock items={g.items} schema={false} />
        </div>
      ))}
    </div>
  </section>

  <!-- One combined FAQPage schema for the whole hub -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema(faqs))} />

  <section class="section flush">
    <div class="container">
      <div class="booking-block" data-reveal>
        <div>
          <div class="eyebrow-rule" style="color: var(--gold-soft); margin-bottom: 28px;">
            <span style="background: var(--navy-deep);">Still wondering?</span>
          </div>
          <h2 class="h-1">Just <em>ask Sam.</em></h2>
          <p class="lede" style="margin-top: 24px;">Leave your number and someone in the family calls back the same business day — or design your suit first and bring the questions to your fitting.</p>
        </div>
        <div class="actions">
          <a href="/book" class="btn is-primary" data-open-booking data-no-transition>Book a Fitting</a>
          <div class="contact-tag" style="margin-top: 12px;">
            Or <a href="/design" style="color: var(--gold-soft); border-bottom: 1px solid var(--gold-soft);">design your suit</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
