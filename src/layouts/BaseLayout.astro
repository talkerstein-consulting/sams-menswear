---
import SiteHeader from '../components/SiteHeader.astro';
import MobileMenu from '../components/MobileMenu.astro';
import BookingModal from '../components/BookingModal.astro';
import SiteFooter from '../components/SiteFooter.astro';

const {
  title = "Sam's Menswear — Custom Tailoring · Vaughan, Thornhill, Toronto",
  description = "Sam's Menswear — a personal master tailor in Vaughan. Wedding suits, business suits, custom shirts and traditional menswear, measured personally.",
  nav = null,
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f2ede1" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Sam's Menswear" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/site.css" />
    <link rel="stylesheet" href="/transitions.css" />
    <link rel="stylesheet" href="/booking.css" />
    <link rel="stylesheet" href="/site-extra.css" />
  </head>
  <body>
    <SiteHeader nav={nav} />
    <MobileMenu />

    <main>
      <slot />
    </main>

    <BookingModal />
    <SiteFooter />

    <script src="/site.js" is:inline></script>
    <script src="/transitions.js" is:inline></script>
    <script src="/booking.js" is:inline></script>
  </body>
</html>
